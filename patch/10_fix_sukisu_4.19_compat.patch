diff --git a/KernelSU/kernel/Kconfig b/KernelSU/kernel/Kconfig
index 0cc760f..08fdc4c 100644
--- a/KernelSU/kernel/Kconfig
+++ b/KernelSU/kernel/Kconfig
@@ -122,6 +122,41 @@ config KSU_SUSFS_SUS_MAP
 	  - It may not be able to evade detections by apps that implement a good injection detection.
 	  - Effective only on zygote spawned umounted user app process >= 10000.
 
+config KSU_SUSFS_TRY_UMOUNT
+	bool "Enable to use ksu's try_umount (legacy SUSFS 1.5.5 option)"
+	depends on KSU_SUSFS
+	default y
+	help
+	  SUSFS 1.5.5 legacy option. The try_umount implementation was removed in
+	  SUSFS 2.2.0 (CMD_SUSFS_ADD_TRY_UMOUNT is deprecated upstream).
+	  Kept only for defconfig compatibility; it has no effect in this tree.
+
+config KSU_SUSFS_AUTO_ADD_SUS_KSU_DEFAULT_MOUNT
+	bool "Auto add KSU default mounts to sus list (legacy SUSFS 1.5.5 option)"
+	depends on KSU_SUSFS
+	default y
+	help
+	  SUSFS 1.5.5 legacy option. Auto-add was replaced in SUSFS 2.2.0 by
+	  automatic fake mnt_id/mnt_group_id handling in SUS_MOUNT.
+	  Kept only for defconfig compatibility; it has no effect in this tree.
+
+config KSU_SUSFS_AUTO_ADD_SUS_BIND_MOUNT
+	bool "Auto add KSU bind mounts to sus list (legacy SUSFS 1.5.5 option)"
+	depends on KSU_SUSFS
+	default y
+	help
+	  SUSFS 1.5.5 legacy option. Auto-add was replaced in SUSFS 2.2.0 by
+	  automatic fake mnt_id/mnt_group_id handling in SUS_MOUNT.
+	  Kept only for defconfig compatibility; it has no effect in this tree.
+
+config KSU_SUSFS_SUS_OVERLAYFS
+	bool "Hide overlayfs mounts (legacy SUSFS 1.5.5 option)"
+	depends on KSU_SUSFS
+	default y
+	help
+	  SUSFS 1.5.5 legacy option. Overlayfs spoofing was removed in SUSFS 2.2.0.
+	  Kept only for defconfig compatibility; it has no effect in this tree.
+
 endmenu
 
 endmenu
