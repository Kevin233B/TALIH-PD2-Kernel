diff --git a/KernelSU/kernel/kernel_includes.h b/KernelSU/kernel/kernel_includes.h
index 8b321883c..c2855aae6 100644
--- a/KernelSU/kernel/kernel_includes.h
+++ b/KernelSU/kernel/kernel_includes.h
@@ -171,4 +171,12 @@
 
 #endif // !CONFIG_FORTIFY_SOURCE
 
+/*
+ * TALIH-PD2 (kernel 4.19) compat: fallthrough attribute/macro was introduced
+ * in newer kernels; provide a safe no-op definition for 4.19 builds.
+ */
+#ifndef fallthrough
+#define fallthrough ((void)0)
+#endif
+
 #endif // __KSU_H_KERNEL_INCLUDES
