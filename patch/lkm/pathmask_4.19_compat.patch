diff --git a/kernel/Makefile b/kernel/Makefile
index 805f08f..a3b3b76 100644
--- a/kernel/Makefile
+++ b/kernel/Makefile
@@ -7,10 +7,21 @@ ODIR := $(MDIR)/out/$(VER)
 
 DEPS := KallRecon
 ifneq ($(MAKECMDGOALS),format)
+ifeq ($(shell test \( $(VERSION) -gt 5 -o \( $(VERSION) -eq 5 -a $(PATCHLEVEL) -ge 10 \) \) && echo y),y)
+# 5.10+ only: KallRecon (deps) reconstructs kallsyms where GKI prunes helper
+# exports. Below 5.10, src/pathmask.c resolves symbols via register_kprobe()
+# instead, so the dependency tree is neither linked nor required.
 include $(MDIR)/mk/deps.mk
 endif
+endif
 
+ifeq ($(shell test \( $(VERSION) -lt 5 -o \( $(VERSION) -eq 5 -a $(PATCHLEVEL) -lt 10 \) \) && echo y),y)
+# Below 5.10 the KallRecon objects are not linked (see above): src/pathmask.c
+# resolves its helper symbols through register_kprobe() on those kernels.
+pathmask-y := src/pathmask.o
+else
 pathmask-y := src/pathmask.o $(DEPS_OBJS_ALL)
+endif
 procguard-y := src/procguard.o
 
 ccflags-y += -std=gnu11
diff --git a/kernel/src/pathmask.c b/kernel/src/pathmask.c
index d236c3d..a8c696b 100644
--- a/kernel/src/pathmask.c
+++ b/kernel/src/pathmask.c
@@ -26,8 +26,20 @@
 #include <asm/syscall.h>
 #include <asm/unistd.h>
 
+#if LINUX_VERSION_CODE < KERNEL_VERSION(5, 9, 0)
+/*
+ * regs_set_return_value() only exists from 5.9; before that the arm64
+ * syscall return value lives in pt_regs->regs[0], which is exactly what
+ * the helper writes.
+ */
+#define regs_set_return_value(regs, val) ((regs)->regs[0] = (val))
+#endif
+
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 10, 0)
+/* KallRecon (deps) resolves pruned helper exports on 5.10+ GKI only. */
 #include "core.h"
 #include "hint.h"
+#endif
 
 #define PM_LOG_PREFIX "pathmask: "
 #define MAX_HIDE_TARGETS 64
@@ -272,6 +284,26 @@ static int __nocfi pm_invoke_close_fd(unsigned int fd)
 
 static unsigned long __nocfi pm_resolve(const char *name)
 {
+#if LINUX_VERSION_CODE < KERNEL_VERSION(5, 10, 0)
+	/*
+	 * Below 5.10 (upstream's KallRecon support floor) resolve through
+	 * register_kprobe(): probe registration resolves the name in-kernel
+	 * and we read the address back from the probe. This is how PathMask
+	 * resolved helpers before KallRecon existed, and it works on 4.x
+	 * where neither the scanner's layout support nor a
+	 * kallsyms_lookup_name export is available.
+	 */
+	struct kprobe kp = {
+		.symbol_name = name,
+	};
+	unsigned long addr;
+
+	if (register_kprobe(&kp))
+		return 0;
+	addr = (unsigned long)kp.addr;
+	unregister_kprobe(&kp);
+	return addr;
+#else
 	unsigned long addr;
 
 	addr = kallrecon_klp(name);
@@ -279,10 +311,15 @@ static unsigned long __nocfi pm_resolve(const char *name)
 		addr = kallsyms_name_to_addr(name);
 
 	return addr;
+#endif
 }
 
 static int pm_symrecon_init(void)
 {
+#if LINUX_VERSION_CODE < KERNEL_VERSION(5, 10, 0)
+	/* Symbols come from kprobe resolution; nothing to recover. */
+	return 0;
+#else
 	struct kallrecon_hint hint = {
 		.scan_back = 0x2000000,
 	};
@@ -300,6 +337,7 @@ static int pm_symrecon_init(void)
 
 	pr_info(PM_LOG_PREFIX "kallsyms ready, %u symbols\n", klnum_val);
 	return 0;
+#endif
 }
 
 static int resolve_path_helpers(void)
@@ -320,6 +358,15 @@ static int resolve_path_helpers(void)
 	 */
 	if (!pm_close_fd)
 		pm_close_fd = (pm_close_fd_t) pm_resolve("close_fd");
+#if LINUX_VERSION_CODE < KERNEL_VERSION(5, 0, 0)
+	/*
+	 * close_fd() was born in the 5.x files_table refactor; 4.19 spells
+	 * the same int(unsigned int fd) helper ksys_close(). Resolve it so
+	 * the openat exit hook keeps releasing fds on old kernels.
+	 */
+	if (!pm_close_fd)
+		pm_close_fd = (pm_close_fd_t) pm_resolve("ksys_close");
+#endif
 
 	pr_info(PM_LOG_PREFIX "resolved VFS path helpers via kallsyms\n");
 	return 0;
