# TALIH-PD2 (MT8797/MT6893) TWRP fstab
# A/B 设备, super 动态分区, /data f2fs FBE v2
# 参考 /vendor/etc/fstab.mt6893 (vendor/mediatek/proprietary/hardware/fstab/mt6893/fstab.in.mt6893)

/data		f2fs	/dev/block/by-name/userdata		flags=display="Data";backup=1;fileencryption=aes-256-xts:aes-256-cts:v2;keydirectory=/metadata/vold/metadata_encryption;quota;reservedsize=128m;wipeingui;wipeduringfactoryreset;fsflags="noatime,nosuid,nodev,reserve_root=134217,resgid=1065"
/system		ext4	/dev/block/mapper/system		flags=display="System";backup=0
/vendor		ext4	/dev/block/mapper/vendor		flags=display="Vendor";backup=0
/product	ext4	/dev/block/mapper/product		flags=display="Product";backup=0
/metadata	ext4	/dev/block/by-name/metadata		flags=display="Metadata";backup=0;wipeingui;formattable
/boot		emmc	/dev/block/by-name/boot		flags=display="Boot";backup=1;flashimg=1;slotselect
/super		emmc	/dev/block/by-name/super		flags=display="Super";backup=1;flashimg=1
/persist	ext4	/dev/block/by-name/persist		flags=display="Persist";backup=1;wipeingui
/nvram		emmc	/dev/block/by-name/nvram		flags=display="NVRAM";backup=1
/nvdata		ext4	/dev/block/by-name/nvdata		flags=display="Nvdata";backup=1
/nvcfg		ext4	/dev/block/by-name/nvcfg		flags=display="Nvcfg";backup=1
/protect_f	ext4	/dev/block/by-name/protect1		flags=display="Protect F";backup=1
/protect_s	ext4	/dev/block/by-name/protect2		flags=display="Protect S";backup=1

/external_sd	auto	/dev/block/mmcblk1p1 /dev/block/mmcblk1	flags=display="MicroSD";storage;wipeingui;removable

/usb_otg	auto	/devices/platform/usb_xhci* /devices/platform/soc/11201000.usb0/11200000.xhci* /devices/platform/usb0/11200000.xhci*	flags=display="USB-OTG";storage;wipeingui;removable
