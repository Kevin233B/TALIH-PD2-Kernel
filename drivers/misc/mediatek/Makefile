# MediaTek misc drivers (vendor increment over google common baseline).
#
# Note: google common baseline has no drivers/misc/mediatek dir, so this
# Makefile is created fresh. Only subdirs that have actually been ported get
# an obj-$(CONFIG_...) hook here; each added in its own stage of the port.

obj-$(CONFIG_MTK_SMI)		+= smi/
obj-$(CONFIG_MTK_CMDQ_MBOX_EXT)	+= cmdq/
obj-$(CONFIG_MTK_IOMMU_MISC)	+= iommu/
obj-$(CONFIG_MMPROFILE)		+= mmp/
obj-$(CONFIG_MTK_TINYSYS_VCP_SUPPORT)	+= vcp/
