# SPDX-License-Identifier: GPL-2.0
# TALIH-PD2 (TALPAD, ls12_mt8797_wifi_64) 5.10 GKI 设备驱动配置片段
# 用法: scripts/kconfig/merge_config.sh -m .config `talih_drivers.config`
# 或: 将内容并入设备 defconfig / mgk_64_k510_defconfig
#
# 说明: 5.10 GKI 全部以模块(=m)方式编译，平台由 DTB 在运行时决定。
# mgk_64_k510_defconfig 已覆盖 MTK 基础设施(regulator/pinctrl/音频machine/相机框架)，
# 本片段仅补充 TALPAD 专属驱动。

# --- 显示面板 (lushan12 HX83121A DSI VDO) ---
CONFIG_DRM_PANEL_LUSHAN12_HX83121A_CDOT_CSOT_WQXGA_VDO=m
CONFIG_DRM_PANEL_LUSHAN12_HX83121A_CDOT_CSOT_WITHOUT_VCOM_WQXGA_VDO=m
CONFIG_AW3750X_POWER=m

# --- 触摸 (Himax HX83121A SPI) ---
CONFIG_TOUCHSCREEN_LUSHAN12_HX83121A_SPI=y
CONFIG_TOUCHSCREEN_HIMAX_CHIPSET=y
CONFIG_TOUCHSCREEN_HIMAX_COMMON=m
CONFIG_TOUCHSCREEN_HIMAX_IC_HX83121A=m

# --- hall / key 开关 ---
CONFIG_HALL_KEY_SWITCH=m

# --- 音频 codec ---
CONFIG_TCT_ES7210=m
CONFIG_TCT_SMARTPA_AW883XX=m

# --- 耳机检测 FSA4480 开关 (accdet 配套 + fsa4480-i2c) ---
CONFIG_TCT_MT6359_FSA4480=m

# --- TCT deviceinfo (misc/mediatek/devinfo) ---
CONFIG_TCT_DEVICEINFO=m

# --- 电池 (mt6885 用 MT6359 PMIC gauge) ---
CONFIG_BATTERY_MT6359P=m

# --- 快充 SC856X 电荷泵 ---
CONFIG_CHARGER_SC856X=m

# --- MEMS 传感器 (sensorhub 2.0 架构 + nanohub) ---
# MTK_SENSOR_SUPPORT / MTK_SENSORHUB 已在 mgk defconfig 中，此处补 nanohub
CONFIG_CUSTOM_KERNEL_SENSORHUB=m
CONFIG_NANOHUB=y
CONFIG_NANOHUB_MTK_IPI=y

# --- 相机传感器 (ls12: gc08a3 前后置 + gc13a0) ---
# 已在 src-v4l2/common/ 移植三个 GalaxyCore 传感器 subdrv
CONFIG_CUSTOM_KERNEL_IMGSENSOR="tsppk8a3288_gc08a3_mipi_raw tsppk8f3287_gc08a3_mipi_raw tsppkcf3290_gc13a0_mipi_raw"
