# ls12 (MT6893 / TALIH-PD2) vendor fragment —— 叠加在 gki_defconfig 之上
#
# 原则（见 [[talih-pd2-stage3-fragment]] / [[talih-pd2-kernel-correctness-principles]]）：
#   1. 只搬 4.19 能开机参考 defconfig (ls12_mt8797_wifi_64_defconfig) 的「设备驱动 =y 集」；
#   2. 核心 flip（LTO/CFI/KASAN/NR_CPUS/PREEMPT/ION 等）一律不碰，全由 gki_defconfig 沿用；
#   3. 本 fragment 纯 ADD-only（只加 =y + 少数显式 not set），不 remove 任何 gki 核心项。
#
# 说明：new config 全默认关，本 fragment 是真正把它打开成可开机 device kernel 的开关集。

# --- 平台底座 ---
CONFIG_ARCH_MEDIATEK=y

# --- Android 开机核心（gki_defconfig 显式缺失、4.19 能开机参考 defconfig 有 =y，boot 致命）---
# 不缺会 "VFS: Unable to mount root fs" 黑屏 / /dev 空：
#   - BLK_DEV_INITRD + RD_GZIP：lk 装载的 ramdisk.cpio.gz 解包成 rootfs 再 /init
#   - DEVTMPFS[_MOUNT]：/dev 设备节点
#   - SECURITYFS：selinux/必备
# 这些是 ADD-only 的 extra 非冻结符号，不 flip 任何冻结 KMI CRC（kmi_probe 仍 0 diff）。
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_SECURITYFS=y

# --- BTF debug info（官方 GKI 必需；core kernel/bpf/btf.c(google 原生) 用 extern __weak __start_BTF/__stop_BTF，
#     该符号仅当 DEBUG_INFO_BTF=y 时由 vmlinux.lds.S 定义。不开 → 链接期弱未定义 → .got.plt/.plt ASSERT
#     （ld.lld: Unexpected GOT/PLT entries detected）拦死 vmlinux。gki_defconfig 只给了 DEBUG_INFO 没给 BTF。
#     ADD-only，不 flip 任何冻结 KMI CRC（BTF 是 debug info 非符号结构））---
CONFIG_DEBUG_INFO_BTF=y

# --- 尺寸硬约束（64MB boot 分区）教训记录：KASAN 【不可】关（CI run 33252268586 实测 FAIL）---
# 实验：关 KASAN → KMI 16 crc_diff + 1 missing 全灭：
#   ① kasan_flag_enabled 是冻结符号（名字无 __kasan 前缀，静态 grep "零 __kasan 符号"误判）；
#   ② slab/memcg 结构有 CONFIG_KASAN 字段级门控（struct kmem_cache kasan_info 等）→
#      kmem_cache_*/mem_cgroup_*/kmalloc_caches 16 个冻结 CRC 全漂。
# Google android12-5.10 KMI 就是 KASAN_HW_TAGS=y 形态下冻结的。64MB 尺寸须另寻刀
# （压缩算法/camera FD 权重/GPU =m 等），不得动 KASAN。

# --- dmabuf system heap（gki_defconfig 只有 DMABUF_HEAPS 框架、无 system heap；system_heap.c
#     里的 mtk_dma_buf_set_name(mml/ged/hcp/cam 引用) 必须编进去，5.10 fork ls12 defconfig =y）---
CONFIG_DMABUF_HEAPS_SYSTEM=y

# --- I2C 总线核（gki_defconfig 显式未开，ls12 参考 defconfig 有 =y）---
CONFIG_I2C=y

# --- clk（mt6893，ls12 参考 defconfig 的实际 13 个 =y 子集）---
CONFIG_COMMON_CLK_MT6893=y
CONFIG_COMMON_CLK_MT6893_APU0=y
CONFIG_COMMON_CLK_MT6893_AUDIOSYS=y
CONFIG_COMMON_CLK_MT6893_CAMSYS_MAIN=y
CONFIG_COMMON_CLK_MT6893_IMGSYS1=y
CONFIG_COMMON_CLK_MT6893_IMP_IIC_WRAP_C=y
CONFIG_COMMON_CLK_MT6893_IPESYS=y
CONFIG_COMMON_CLK_MT6893_MDPSYS=y
CONFIG_COMMON_CLK_MT6893_MFGCFG=y
CONFIG_COMMON_CLK_MT6893_MMSYS=y
CONFIG_COMMON_CLK_MT6893_SCP_ADSP=y
CONFIG_COMMON_CLK_MT6893_VDECSYS=y
CONFIG_COMMON_CLK_MT6893_VENCSYS=y

# --- pinctrl（mt6885，paris 框架；禁用老 PINCTRL_MT6397 → 规避 broken 老框架）---
CONFIG_PINCTRL_MT6885=y
CONFIG_PINCTRL_MTK_PARIS=y
CONFIG_PINCTRL_MTK_V2=y
# CONFIG_PINCTRL_MT6397 is not set

# --- SPMI（mt6315 proc PMIC 供 Vcore，boot 关键）---
CONFIG_SPMI_MTK_PMIF=y

# --- mfd（mt6359p 复用 mt6397-core + mt6360 + SPMI pmic）---
CONFIG_MFD_MT6397=y
CONFIG_MFD_MT6360=y
CONFIG_MFD_MTK_SPMI_PMIC=y

# --- regulator ---
CONFIG_REGULATOR_MT6315=y
CONFIG_REGULATOR_MT6359P=y
CONFIG_REGULATOR_MT6360=y

# --- UFS 存储 + phy ---
CONFIG_SCSI_UFS_MEDIATEK=y
CONFIG_PHY_MTK_UFS=y
CONFIG_PHY_MTK_TPHY=y

# --- soc/mediatek 底座 + 内存保护 ---
CONFIG_MTK_SCPSYS=y
CONFIG_MTK_PMIC_WRAP=y
CONFIG_MTK_INFRACFG=y
CONFIG_MTK_DVFSRC=y
CONFIG_MTK_DEVAPC=y
CONFIG_MTK_DEVMPU=y
CONFIG_MTK_SOCINFO=y

# --- tinysys IPI/mbox 底座 + SCP（4.19 能开机 defconfig 全 =y）---
# mtk_tinysys_ipi.c(MTK_IPI) 提供 mtk_ipi_register/send，被 gpueb/vcp/mcupm/cm_mgr/
# thermal/sensor 等几十个 =y 驱动引用；其依赖链 MTK_MBOX → RPMSG_MTK → MTK_IPI。
# MTK_TINYSYS_SCP_SUPPORT 编 scp/rv/ 框架，提供 scp_ipidev 符号(EXPORT)。
# 全链从 gki-5.10 fork 搬 mtk-mbox.c/mtk_rpmsg_mbox.c/mtk_tinysys_ipi.c 三个缺失文件。
CONFIG_MTK_MBOX=y
CONFIG_RPMSG_MTK=y
CONFIG_MTK_IPI=y
CONFIG_MTK_TINYSYS_SCP_SUPPORT=y
CONFIG_MTK_TINYSYS_SCP_LOGGER_SUPPORT=y

# --- memory（镜像 4.19：仅 MTK_DRAMC=y；HAVE_MTK_MC/MTK_EMI 保持不设 → 与 4.19 同为死码，不改行为）---
CONFIG_MTK_DRAMC=y
CONFIG_MTK_CACHE_PARITY_CHECK=y

# --- leds / 背光 / flashlight ---
CONFIG_LEDS_MTK=y
CONFIG_LEDS_MTK_DISP=y
CONFIG_LEDS_MTK_PWM=y
CONFIG_LEDS_REGULATOR_VIBRATOR=y
CONFIG_MTK_FLASHLIGHT=y
CONFIG_RT_FLASHLIGHT=y
# richtek 闪光灯框架(rt-flashlight + rtfled)已从 4.19 移植——与 5.10 fork 的
# flashlights-mt6360.c 消费者 API 同名同签名(find_flashlight_by_name/set_mode/
# is_ready/set_torch_brightness/set_strobe_brightness/set_strobe_timeout)。
# 注：运行期出光仍需 mt6360_pmu_fled.c HAL，但 4.19 该 HAL 走旧 mt6360_pmu_reg_read/
# write 核(5.10 已换 MFD/regmap 核)，故此处只补框架+torch 控制层编译，HAL 单独适配。
CONFIG_MTK_FLASHLIGHT_MT6360=y

# --- iommu / smi ---
CONFIG_MTK_IOMMU=y
CONFIG_MTK_IOMMU_MISC=y
CONFIG_MTK_IOMMU_MISC_DBG=y
CONFIG_MTK_SMI=y

# --- cmdq（禁主线 MTK_CMDQ，走 vendor ext）---
CONFIG_MTK_CMDQ_MBOX_EXT=y
# CONFIG_MTK_CMDQ is not set

# --- display（mediatek_v2 + mml + HX83121A panel）---
# gki_defconfig 只有 DRM=y + BACKLIGHT_CLASS_DEVICE=y，缺 DSI/KMS/panel/bridge 核心 helper，
# 缺则 DRM_MEDIATEK_V2/panel 被 Kconfig 静默丢弃 → 无显示驱动（DSI 首帧 crash 风险，同 4.19 bootloop）。
CONFIG_DRM_MIPI_DSI=y
CONFIG_DRM_KMS_HELPER=y
# KMI 硬门禁：DRM_FBDEV_EMULATION 必须 not set（与 gki_defconfig 一致，default y 需显式压住）。
# 它 select DRM_KMS_FB_HELPER → select FB + FB_DEFERRED_IO（连带 FRAMEBUFFER_CONSOLE/FB_SYS_*/FB_CFB_*）。
# FB_DEFERRED_IO 在 struct fb_info 里门控 deferred_work/fbdefio 两字段 → fb_info 布局变 →
# 经 backlight_ops.check_fb(struct fb_info*)/drm_panel.backlight 到达 fb_info 的冻结符号
# CRC 集体漂移（实测 46 个 crc_diff：backlight_* / devm_drm_panel_bridge_add / drm_crtc_helper_*）。
# MTK v2 显示不依赖 fbdev：mediatek_v2 Kconfig 无依赖、v2 mtk_drm_drv.c 零 fb_helper 引用，
# Makefile 仅以 $(CONFIG_DRM_FBDEV_EMULATION) 门控 mtk_drm_fbdev.o；Android userspace 走
# DRM native（hwcomposer/gralloc），开机 logo 由 lk 负责，内核无需 legacy fbcon。
# CONFIG_DRM_FBDEV_EMULATION is not set
CONFIG_DRM_PANEL=y
CONFIG_DRM_PANEL_ORIENTATION_QUIRKS=y
CONFIG_DRM_BRIDGE=y
CONFIG_DRM_PANEL_BRIDGE=y
CONFIG_DRM_MEDIATEK=y
CONFIG_DRM_MEDIATEK_V2=y
CONFIG_MTK_MML=y
CONFIG_DRM_PANEL_LUSHAN12_HX83121A_CDOT_CSOT_WQXGA_VDO=y
CONFIG_DRM_PANEL_LUSHAN12_HX83121A_CDOT_CSOT_WITHOUT_VCOM_WQXGA_VDO=y
CONFIG_AW3750X_POWER=y
# 显示管线配套（AAL 自适应亮度 + disp PWM 背光 + 圆角），缺失会导致背光点不亮/黑屏
CONFIG_MTK_AAL_SUPPORT=y
CONFIG_PWM_MTK_DISP=y
CONFIG_MTK_ROUND_CORNER_SUPPORT=y

# --- audio（mt6885 + mt6359p）---
CONFIG_SND_SOC_MT6885=y
CONFIG_SND_SOC_MT6885_MT6359P=y
CONFIG_SND_SOC_MT6359=y
CONFIG_SND_SOC_MT6359P_ACCDET=y
CONFIG_SND_SOC_MTK_SRAM=y
CONFIG_SND_SOC_MTK_SMART_PHONE=y
# audio DSP IPI（4.19 defconfig 有 =y）：audio HAL 经 ADSP 子系统通信。
# 依赖链 MTK_AUDIODSP_SUPPORT(adsp/ 框架 Stage2 已搬)→MTK_AUDIO_IPI(audio_ipi/)。
# 不影响开机（纯 userspace 音频功能），对齐 4.19 补齐。
CONFIG_MTK_AUDIODSP_SUPPORT=y
CONFIG_MTK_AUDIO_IPI=y
# 蓝牙通话 CVSD/MSBC 软件通路（4.19 =y），无依赖纯 ALSA 驱动
CONFIG_SND_SOC_MTK_BTCVSD=y

# --- nvmem / iio（校准数据 + auxadc）---
CONFIG_MTK_DEVINFO=y
CONFIG_TCT_DEVICEINFO=y
CONFIG_MEDIATEK_MT635X_AUXADC=y
# SoC 级 auxadc（mt6893.dtsi auxadc@11001000 "mediatek,mt6765-auxadc"，google 主线
# mt6577_auxadc.c 兼容）。ls12 板级 3 个 NTC 热敏（generic-adc-thermal，io-channels=<&auxadc 0/1/2>）
# 走它；不开=板温全失→thermal zones 无源。GENERIC_ADC_THERMAL depends on IIO，而
# gki_defconfig 未开 IIO，须一并补。
CONFIG_IIO=y
CONFIG_MEDIATEK_MT6577_AUXADC=y
CONFIG_GENERIC_ADC_THERMAL=y

# --- cpufreq（mt6893 dts "mediatek,cpufreq-hw" performance-controller 节点）---
# 上游 ARM_MEDIATEK_CPUFREQ 只支持 mt2701..mt8516；mt6893 走 HW 引擎驱动
# （自 gki-5.10 fork 移植 mediatek-cpufreq-hw.c）。不开=performance-controller 无驱动
# →无 cpufreq→thermal cooling 无处降频。KMI 核验：SCHEDUTIL 在 sched.h 两处门控均为
# 函数/静态内联（非结构体字段）→零 CRC 影响；xml 零 sugov/__kasan 冻结符号。
CONFIG_ARM_MEDIATEK_CPUFREQ_HW=y
# governor：4.19/fork 参考 defconfig 均为 DEFAULT_GOV_SCHEDUTIL+USERSPACE+ONDEMAND
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y

# --- thermal 全链（SoC LVTS + PMIC 温控 + thermal-ipi）---
# mt6893.dtsi 18 个 thermal zone 的 sensor 全部 <&lvts N>（"mediatek,mt6893-lvts"，
# lvts@1100b000：nvmem-cells lvts_e_data1/2 + resets infracfg_rst）——LVTS 是唯一
# sensor provider，不开=全部 zone 无源→关机保护失效。soc_temp_lvts.c 依赖
# NVMEM(gki 未开)+RESET_TI_SYSCON(gki 未开)，olddefconfig 会静默丢行，须显式补。
CONFIG_NVMEM=y
CONFIG_RESET_TI_SYSCON=y
CONFIG_MTK_SOC_THERMAL_LVTS=y
# thermal-ipi 节点(target-bitmask 0x2=MCUPM)：MTK_THERMAL_IPI depends on
# SSPM_SUPPORT||MCUPM_SUPPORT，两者均须开（tinysys 框架 Stage2 已搬）。
CONFIG_MTK_TINYSYS_MCUPM_SUPPORT=y
CONFIG_MTK_TINYSYS_SSPM_SUPPORT=y
CONFIG_MTK_TINYSYS_SSPM_V2=y
CONFIG_MTK_THERMAL_IPI=y
# PMIC 温控（mt6359p.dtsi "mediatek,mt6359p-efuse" provider → thermal_efuse_data1
# 等校准 cell → pmic_temp 消费）：MTK_PMIC_THERMAL depends on MT635X_EFUSE+MT635X_AUXADC。
# mt635x-efuse.c 自 gki-5.10 fork drivers/nvmem 移植（depends MFD_MT6397=y 已开）。
CONFIG_MT635X_EFUSE=y
CONFIG_MTK_PMIC_THERMAL=y

# --- rtc / watchdog ---
CONFIG_RTC_DRV_MT6397=y
CONFIG_MEDIATEK_WATCHDOG=y

# --- 基础 I/O 总线（MTK 变体）---
CONFIG_I2C_MT65XX=y
CONFIG_SPI_MT65XX=y
CONFIG_MMC_MTK=y
CONFIG_MMC_CQHCI=y
CONFIG_SERIAL_8250_MT6577=y
CONFIG_EINT_MTK=y
CONFIG_MTK_PWM=y
# DMA（cqdma 命令队列供 storage/fingerprint；apdma 供 uart）
CONFIG_MTK_CQDMA=y
CONFIG_MTK_UART_APDMA=y

# --- 输入 ---
CONFIG_KEYBOARD_MTK_PMIC=y

# --- charger（mt6360 + 主充电 + pump express）---
CONFIG_MTK_CHARGER=y
CONFIG_MTK_CHARGER_TYPE_DETECT=y
CONFIG_CHARGER_MT6360=y
# sc856x 快充泵依赖 dvchg_class.h(fork/main/oneplus 均无的 5.10 闭源 direct-charger 框架)；
# 关闭=基础充电走 mt6360 PMIC，快充泵延后 Stage4。全树仅 sc856x_charger.c 这一个消费者。
# CONFIG_CHARGER_SC856X is not set
CONFIG_MTK_PUMP_EXPRESS_PLUS_SUPPORT=y
CONFIG_MTK_PUMP_EXPRESS_PLUS_20_SUPPORT=y
CONFIG_MTK_PUMP_EXPRESS_50_SUPPORT=y

# --- USB / Type-C ---
CONFIG_USB_MTU3=y
CONFIG_EXTCON_MTK_USB=y
CONFIG_MTK_USB_TYPEC=y
CONFIG_MTK_USB_TYPEC_MUX=y
CONFIG_MTK_USB_TYPEC_DP_MUX=y
CONFIG_TCPC_CLASS=y
CONFIG_TCPC_MT6360=y
# USB PD 引擎（pd_policy_engine/pd_process_evt/pd_dpm 全家），tcpci_timer.c 基座无条件用
# PD_TIMER_* 枚举，而该枚举被 IS_ENABLED(CONFIG_USB_POWER_DELIVERY) 门控 → 不开则
# "undeclared identifier PD_TIMER_SENDER_RESPONSE"。fork 参照 defconfig 有 =y。
CONFIG_USB_POWER_DELIVERY=y
CONFIG_MTK_TYPEC_WATER_DETECT=y
CONFIG_MTK_TYPEC_WATER_DETECT_BY_PCB=y
CONFIG_TCT_MT6359_FSA4480=y

# --- touch（HX83121A 触控，SPI）---
CONFIG_TOUCHSCREEN_HIMAX_COMMON=y
CONFIG_TOUCHSCREEN_HIMAX_CHIPSET=y
CONFIG_TOUCHSCREEN_HIMAX_IC_HX83121A=y
CONFIG_TOUCHSCREEN_LUSHAN12_HX83121A_SPI=y
CONFIG_TOUCHSCREEN_HIMAX_DEBUG=y
CONFIG_TOUCHSCREEN_HIMAX_INSPECT=y

# --- 低功耗（lpm）---
CONFIG_MTK_LPM_MT6885=y
CONFIG_MTK_LPM_MT6893=y

# --- 热管理 ---
CONFIG_MTK_THERMAL=y

# --- AEE（Android Exception Engine，drm_v2/cmdq/camsys 等 vendor 驱动的 mtk_log.h 依赖）---
# MTK_AEE_FEATURE 门控 <aee.h>（定义 aee_kernel_exception_api 宏 + DB_OPT_* 枚举），
# 不开则 mtk_drm_crtc.c 的 DDPAEE_1 展开报「implicit declaration」+ 未声明枚举；
# MTK_AEE_AED 编译 aee-common.o 提供 aee_kernel_exception_api_func 定义（修链接），
# MTK_HANG_DETECT 关闭时 aee.h 的 monitor_hang_regist_ldt #else 分支是「非 static 空函数体」，
# 会被每个 include aee.h 的 vendor 驱动各自发射一份 → vmlinux 链接 duplicate symbol。
# 开 =y 后 aee.h 只留声明、hang_detect.c 提供唯一实现（与 4.19 能开机 defconfig 一致）。
CONFIG_MTK_AEE_FEATURE=y
CONFIG_MTK_AEE_AED=y
CONFIG_MTK_AEE_IPANIC=y
CONFIG_MTK_HANG_DETECT=y

# --- GPU（Mali-G77 MC9，mali-valhall DDK 真机同款 r32p1）---
# Stage 2 commit 9990004 搬入 1782 文件但默认关（保 KMI 零污染），此处首次启用。
# VERSION 串四词有讲究（gpu/mediatek 各级 Makefile 解析）：word2=valhall → gpu_mali/
# mali_valhall/；word3=r32p1 → 真机同款 DDK 目录（4.19 main 权威 defconfig 同版）；
# word4=mt6893 → 顶层 Makefile 取 MTK_PLATFORM → -DCONFIG_GPU_MT6893（缺后缀则
# 平台宏失效）。fork 参考 defconfig 原串即 "mali valhall r32p1 mt6893"。
# 纯 vendor 增量（google 无 drivers/gpu/mediatek）→ 理论零 KMI 污染，CI 门禁验证。
# ion/SVP 桥接已被 config 门控围住（MTK_IOMMU_V2/TRUSTED_MEMORY 均不开）零风险。
# GPU =y 不影响 boot（显示走 DSI 不依赖 GPU），失败仅无 GPU 加速。
# ⚠️ 勿加 CONFIG_MALI_MIDGARD 行：midgard/Kconfig 未被 source 进任何主 Kconfig 链
# （olddefconfig 会静默丢行），真编译门控在 Kbuild 变量层——midgard/Kbuild include
# 的 Kbuild-mtk-custom-env 里 `CONFIG_MALI_MIDGARD := $(CONFIG_MTK_GPU_SUPPORT)`、
# `CONFIG_MALI_PLATFORM_NAME := $(MTK_PLATFORM)`（4.19 真机同机制：defconfig 无
# MALI 行仍编入，真机 Image 实测 36 个 mali_kbase 符号 + 80 个 ged/gpufreq 符号）。
CONFIG_MTK_GPU_SUPPORT=y
CONFIG_MTK_GPU_VERSION="mali valhall r32p1 mt6893"
CONFIG_MTK_GPU_COMMON_DVFS_SUPPORT=y
