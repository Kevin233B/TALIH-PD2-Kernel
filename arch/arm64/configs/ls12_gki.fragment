# ls12 (MT6893 / TALIH-PD2) vendor fragment —— 叠加在 gki_defconfig 之上
#
# 原则（见 [[talih-pd2-stage3-fragment]] / [[talih-pd2-kernel-correctness-principles]]）：
#   1. 只搬 4.19 能开机参考 defconfig (ls12_mt8797_wifi_64_defconfig) 的「设备驱动 =y 集」；
#   2. 核心 flip（LTO/CFI/KASAN/NR_CPUS/PREEMPT/ION 等）一律不碰，全由 gki_defconfig 沿用；
#   3. 本 fragment 纯 ADD-only（只加 =y + 少数显式 not set），不 remove 任何 gki 核心项。
#
# 说明：new config 全默认关，本 fragment 是真正把它打开成可开机 device kernel 的开关集。

# --- 平台底座 ---
CONFIG_ARCH_MEDIATEK=y

# --- Android 开机核心（gki_defconfig 显式缺失、4.19 能开机参考 defconfig 有 =y，boot 致命）---
# 不缺会 "VFS: Unable to mount root fs" 黑屏 / /dev 空：
#   - BLK_DEV_INITRD + RD_GZIP：lk 装载的 ramdisk.cpio.gz 解包成 rootfs 再 /init
#   - DEVTMPFS[_MOUNT]：/dev 设备节点
#   - SECURITYFS：selinux/必备
# 这些是 ADD-only 的 extra 非冻结符号，不 flip 任何冻结 KMI CRC（kmi_probe 仍 0 diff）。
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_SECURITYFS=y

# --- I2C 总线核（gki_defconfig 显式未开，ls12 参考 defconfig 有 =y）---
CONFIG_I2C=y

# --- clk（mt6893，ls12 参考 defconfig 的实际 13 个 =y 子集）---
CONFIG_COMMON_CLK_MT6893=y
CONFIG_COMMON_CLK_MT6893_APU0=y
CONFIG_COMMON_CLK_MT6893_AUDIOSYS=y
CONFIG_COMMON_CLK_MT6893_CAMSYS_MAIN=y
CONFIG_COMMON_CLK_MT6893_IMGSYS1=y
CONFIG_COMMON_CLK_MT6893_IMP_IIC_WRAP_C=y
CONFIG_COMMON_CLK_MT6893_IPESYS=y
CONFIG_COMMON_CLK_MT6893_MDPSYS=y
CONFIG_COMMON_CLK_MT6893_MFGCFG=y
CONFIG_COMMON_CLK_MT6893_MMSYS=y
CONFIG_COMMON_CLK_MT6893_SCP_ADSP=y
CONFIG_COMMON_CLK_MT6893_VDECSYS=y
CONFIG_COMMON_CLK_MT6893_VENCSYS=y

# --- pinctrl（mt6885，paris 框架；禁用老 PINCTRL_MT6397 → 规避 broken 老框架）---
CONFIG_PINCTRL_MT6885=y
CONFIG_PINCTRL_MTK_PARIS=y
CONFIG_PINCTRL_MTK_V2=y
# CONFIG_PINCTRL_MT6397 is not set

# --- SPMI（mt6315 proc PMIC 供 Vcore，boot 关键）---
CONFIG_SPMI_MTK_PMIF=y

# --- mfd（mt6359p 复用 mt6397-core + mt6360 + SPMI pmic）---
CONFIG_MFD_MT6397=y
CONFIG_MFD_MT6360=y
CONFIG_MFD_MTK_SPMI_PMIC=y

# --- regulator ---
CONFIG_REGULATOR_MT6315=y
CONFIG_REGULATOR_MT6359P=y
CONFIG_REGULATOR_MT6360=y

# --- UFS 存储 + phy ---
CONFIG_SCSI_UFS_MEDIATEK=y
CONFIG_PHY_MTK_UFS=y
CONFIG_PHY_MTK_TPHY=y

# --- soc/mediatek 底座 + 内存保护 ---
CONFIG_MTK_SCPSYS=y
CONFIG_MTK_PMIC_WRAP=y
CONFIG_MTK_INFRACFG=y
CONFIG_MTK_DVFSRC=y
CONFIG_MTK_DEVAPC=y
CONFIG_MTK_DEVMPU=y
CONFIG_MTK_SOCINFO=y

# --- memory（镜像 4.19：仅 MTK_DRAMC=y；HAVE_MTK_MC/MTK_EMI 保持不设 → 与 4.19 同为死码，不改行为）---
CONFIG_MTK_DRAMC=y
CONFIG_MTK_CACHE_PARITY_CHECK=y

# --- leds / 背光 / flashlight ---
CONFIG_LEDS_MTK=y
CONFIG_LEDS_MTK_DISP=y
CONFIG_LEDS_MTK_PWM=y
CONFIG_LEDS_REGULATOR_VIBRATOR=y
CONFIG_MTK_FLASHLIGHT=y
CONFIG_MTK_FLASHLIGHT_MT6360=y

# --- iommu / smi ---
CONFIG_MTK_IOMMU=y
CONFIG_MTK_IOMMU_MISC=y
CONFIG_MTK_SMI=y

# --- cmdq（禁主线 MTK_CMDQ，走 vendor ext）---
CONFIG_MTK_CMDQ_MBOX_EXT=y
# CONFIG_MTK_CMDQ is not set

# --- display（mediatek_v2 + mml + HX83121A panel）---
# gki_defconfig 只有 DRM=y + BACKLIGHT_CLASS_DEVICE=y，缺 DSI/KMS/panel/bridge 核心 helper，
# 缺则 DRM_MEDIATEK_V2/panel 被 Kconfig 静默丢弃 → 无显示驱动（DSI 首帧 crash 风险，同 4.19 bootloop）。
CONFIG_DRM_MIPI_DSI=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_KMS_FB_HELPER=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_PANEL=y
CONFIG_DRM_PANEL_ORIENTATION_QUIRKS=y
CONFIG_DRM_BRIDGE=y
CONFIG_DRM_PANEL_BRIDGE=y
CONFIG_DRM_MEDIATEK=y
CONFIG_DRM_MEDIATEK_V2=y
CONFIG_MTK_MML=y
CONFIG_DRM_PANEL_LUSHAN12_HX83121A_CDOT_CSOT_WQXGA_VDO=y
CONFIG_DRM_PANEL_LUSHAN12_HX83121A_CDOT_CSOT_WITHOUT_VCOM_WQXGA_VDO=y
CONFIG_AW3750X_POWER=y
# 显示管线配套（AAL 自适应亮度 + disp PWM 背光 + 圆角），缺失会导致背光点不亮/黑屏
CONFIG_MTK_AAL_SUPPORT=y
CONFIG_PWM_MTK_DISP=y
CONFIG_MTK_ROUND_CORNER_SUPPORT=y

# --- audio（mt6885 + mt6359p）---
CONFIG_SND_SOC_MT6885=y
CONFIG_SND_SOC_MT6885_MT6359P=y
CONFIG_SND_SOC_MT6359=y
CONFIG_SND_SOC_MT6359P_ACCDET=y
CONFIG_SND_SOC_MTK_SRAM=y
CONFIG_SND_SOC_MTK_SMART_PHONE=y

# --- nvmem / iio（校准数据 + auxadc）---
CONFIG_MTK_DEVINFO=y
CONFIG_TCT_DEVICEINFO=y
CONFIG_MEDIATEK_MT635X_AUXADC=y

# --- rtc / watchdog ---
CONFIG_RTC_DRV_MT6397=y
CONFIG_MEDIATEK_WATCHDOG=y

# --- 基础 I/O 总线（MTK 变体）---
CONFIG_I2C_MT65XX=y
CONFIG_SPI_MT65XX=y
CONFIG_MMC_MTK=y
CONFIG_MMC_CQHCI=y
CONFIG_SERIAL_8250_MT6577=y
CONFIG_EINT_MTK=y
CONFIG_MTK_PWM=y
# DMA（cqdma 命令队列供 storage/fingerprint；apdma 供 uart）
CONFIG_MTK_CQDMA=y
CONFIG_MTK_UART_APDMA=y

# --- 输入 ---
CONFIG_KEYBOARD_MTK_PMIC=y

# --- charger（mt6360 + 主充电 + pump express）---
CONFIG_MTK_CHARGER=y
CONFIG_MTK_CHARGER_TYPE_DETECT=y
CONFIG_CHARGER_MT6360=y
CONFIG_CHARGER_SC856X=y
CONFIG_MTK_PUMP_EXPRESS_PLUS_SUPPORT=y
CONFIG_MTK_PUMP_EXPRESS_PLUS_20_SUPPORT=y
CONFIG_MTK_PUMP_EXPRESS_50_SUPPORT=y

# --- USB / Type-C ---
CONFIG_USB_MTU3=y
CONFIG_EXTCON_MTK_USB=y
CONFIG_MTK_USB_TYPEC=y
CONFIG_MTK_USB_TYPEC_MUX=y
CONFIG_MTK_USB_TYPEC_DP_MUX=y
CONFIG_TCPC_CLASS=y
CONFIG_TCPC_MT6360=y
CONFIG_TCT_MT6359_FSA4480=y

# --- touch（HX83121A 触控，SPI）---
CONFIG_TOUCHSCREEN_HIMAX_COMMON=y
CONFIG_TOUCHSCREEN_HIMAX_CHIPSET=y
CONFIG_TOUCHSCREEN_HIMAX_IC_HX83121A=y
CONFIG_TOUCHSCREEN_LUSHAN12_HX83121A_SPI=y
CONFIG_TOUCHSCREEN_HIMAX_DEBUG=y
CONFIG_TOUCHSCREEN_HIMAX_INSPECT=y

# --- 低功耗（lpm）---
CONFIG_MTK_LPM_MT6885=y
CONFIG_MTK_LPM_MT6893=y

# --- 热管理 ---
CONFIG_MTK_THERMAL=y
